# Login for the dashboard
ADMIN_USER=admin
ADMIN_PASSWORD=

# Shared secret agents use to report in. Generate with: openssl rand -hex 32
AGENT_TOKEN=

# Host address the dashboard listens on:
#   127.0.0.1      this machine only
#   100.x.y.z      your Tailscale IP (reachable from your tailnet)
#   0.0.0.0        all interfaces (only behind an HTTPS reverse proxy)
BIND_ADDR=127.0.0.1
PORTMAP_PORT=8080

# 1 when served over HTTPS
COOKIE_SECURE=0
# 1 only behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=0

# Optional: name shown for this machine (defaults to its hostname)
HOST_NAME=

# 0 = send process names only, not full command lines (they can contain secrets)
SEND_CMDLINE=1
