# Address of the portmap dashboard, as this machine can reach it
SERVER_URL=http://<dashboard-ip>:8080
# Same AGENT_TOKEN as in the dashboard's .env
AGENT_TOKEN=
# Optional: name shown for this machine (defaults to its hostname)
HOST_NAME=

# 0 = send process names only, not full command lines (they can contain secrets)
SEND_CMDLINE=1
